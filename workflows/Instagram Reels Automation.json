{
  "name": "Instagram Reels Automation",
  "nodes": [
    {
      "parameters": {
        "content": "## ⏰ This workflow runs daily at 8 PM.\n\n## It fetches TikTok videos → filters them → avoids duplicates → posts to Instagram Reels automatically.",
        "height": 120,
        "width": 1164
      },
      "id": "cc9a0749-9213-4705-a40a-7827085e056b",
      "name": "Workflow Overview",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        128,
        -1040
      ],
      "typeVersion": 1
    },
    {
      "parameters": {
        "content": "### 🎯 Calls TikTok API to fetch 20 videos based on keyword. You can change niche here.\n### 🔀 Splits videos into separate items so each video is processed individually.\n### 🎯 Filters videos:\n- Duration between 20–40 sec             You can customize this.\n### 🎲 Picks ONE random video to avoid repetition.\n### 🧹 Extracts only needed fields: video_id + video_url",
        "height": 438,
        "width": 1036,
        "color": 4
      },
      "id": "961b8b3b-fe93-4bf3-b600-61ba5512b961",
      "name": "TikTok API Note",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        144,
        -736
      ],
      "typeVersion": 1
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 20
            }
          ]
        }
      },
      "id": "3252960d-ded7-4b37-8cde-1464902f1ecb",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        64,
        -512
      ]
    },
    {
      "parameters": {
        "url": "https://tiktok-scraper7.p.rapidapi.com/feed/search",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "keywords",
              "value": "@motivationaltrained"
            },
            {
              "name": "count",
              "value": "20"
            },
            {
              "name": "region",
              "value": "eg"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-RapidAPI-Key",
              "value": "YOUR_API_KEY"
            },
            {
              "name": "X-RapidAPI-Host",
              "value": "tiktok-scraper7.p.rapidapi.com"
            }
          ]
        },
        "options": {}
      },
      "id": "1d435658-1ea3-4825-b5eb-d7492d5e4db2",
      "name": "Tiktok API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        272,
        -512
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "data.videos",
        "options": {}
      },
      "id": "287f6279-dd54-4b01-89d1-65fb3231faa6",
      "name": "Split Videos",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        464,
        -512
      ]
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.duration }}",
              "rightValue": 40,
              "operator": {
                "type": "number",
                "operation": "lte"
              }
            },
            {
              "leftValue": "={{ $json.duration }}",
              "rightValue": 20,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            },
            {
              "leftValue": "={{ $json.title }}",
              "rightValue": "#gym",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "b611e796-2abd-483a-b707-3d1ae45b8c7e",
      "name": "Filter Videos",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        672,
        -512
      ]
    },
    {
      "parameters": {
        "keep": "={{ $input.all().randomItem() }}"
      },
      "id": "256b1627-3a49-4625-aae7-a2743294064a",
      "name": "Pick Random Video",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [
        864,
        -512
      ]
    },
    {
      "parameters": {
        "options": {}
      },
