        -512
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": "YOUR_SHEET_ID",
        "sheetName": "Sheet1",
        "columns": {
          "value": {
            "video_id": "={{ $('Clean Data').item.json.video_id }}"
          }
