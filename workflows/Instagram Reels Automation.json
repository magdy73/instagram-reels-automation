      "typeVersion": 3,
      "position": [
        1072,
        -512
      ]
    },
    {
      "parameters": {
        "documentId": "YOUR_SHEET_ID",
        "sheetName": "Sheet1",
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "video_id",
              "lookupValue": "={{ $json.video_id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "39f081cf-58bd-4486-a4b7-f2a00ac62c6e",
      "name": "Check Duplicate",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        1264,
        -512
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nif (items.length === 0 || Object.keys(items[0].json).length === 0) {\n  return [{ json: { isDuplicate: false } }];\n} else {\n  return [{ json: { isDuplicate: true } }];\n}"
      },
      "id": "26bf25ef-9147-471d-9db5-7ec2818a7ee8",
      "name": "Duplicate Logic",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1472,
        -512
      ]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.isDuplicate }}",
              "operator": {
                "type": "boolean",
                "operation": "false"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "5dfd40f4-9e99-46fe-bf57-94f6e16299aa",
      "name": "Is New?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
